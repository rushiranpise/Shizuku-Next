    <!-- Home - Wireless Adb -->
    <string name="home_wireless_adb_title"><![CDATA[Simulan gamit ang Wireless na pag-debug]]></string>
    <!-- The platform says "not optimized" and Samsung says "unrestricted" for the same state,
         and "Battery optimization: not optimized" reads as a fault to anyone holding the phone.
         "unrestricted" says what the app did and what it is: left alone. -->
    <!-- Adb -->
    <string name="dialog_adb_invalid_port">Ang port ay isang integer mula 1 hanggang 65535.</string>
    <string name="adb_pairing">Pagpapares</string>
    <string name="dialog_adb_pairing_title">Makipagpares sa device</string>
    <string name="dialog_adb_pairing_discovery">Hinahanap ang serbisyo ng pagpapares</string>
    <string name="dialog_adb_pairing_paring_code">Code ng pagpapares</string>
    <string name="paring_code_is_wrong">Mali ang code ng pagpapares.</string>
    <string name="cannot_connect_port">Hindi makakonekta sa serbisyo ng wireless
        debugging.\n\nPakitiyak na naka-whitelist ang Shizuku sa lahat ng firewall, ad-block, VPN, o
        mga katulad na app na maaaring maghigpit sa pag-access sa network.</string>
    <string name="dialog_adb_pairing_message">Mangyaring simulan ang pagpapares sa pamamagitan ng
        pagsasagawa ng mga sumusunod na hakbang:\n- Mag-navigate sa \"Mga Pagpipilian sa
        Developer\"\n- Paganahin ang \"USB debugging\" at \"Wireless debugging\"\n- I-tap ang
        kaliwang bahagi ng \"Wireless debugging\"\n- I-tap ang \"Ipares ang aparato na may code ng
        pagpapares\"\n- Ipasok ang code ng pagpapares sa abiso</string>
    <!-- Goes after dialog_adb_pairing_accessibility_enable in the same dialog: what the greyed-out
         row means, and both ways to open it. The App info menu is the only one available on a
         phone with no computer attached, the app-ops command is the same app-op written from
         outside the app, and both are named because either reader may be the one holding it. -->
    <!-- The TV form of dialog_adb_pairing_accessibility_permission. TV Settings has no menu in
         App info, so there is no "Allow restricted settings" to point at; ^1 is the app-ops
         command. -->
    <string name="dialog_adb_pairing_accessibility_navigate">Simulan ang pagpapares sa pamamagitan ng pagsunod sa mga sumusunod na hakbang:\n- Magpunta sa \"Mga opsyon ng developer\"\n- I-tap ang \"Pag-debug ng USB\" at \"Wireless na pag-debug\"\n- I-tap ang kaliwang bahagi ng \"Wireless na pag-debug\"\n- I-tap ang \"Ipares ang device sa pagpapares ng code.\" Awtomatikong makikita ng Shizuku ang code ng pagpapares.</string>
    <string name="adb_pairing_requires_multi_window">Pumunta muna sa split-screen (multi-window)
        mode.</string>
    <string name="adb_pairing_requires_multi_window_reason">Kinakailangan ng system na laging
        nakikita ang dialog ng pagpapares. Ang paggamit ng split-screen mode ay ang tanging paraan
        upang hayaan ang app na ito at ang dialog ng system na makita sa parehong oras.</string>
    <string name="adb_error_key_store">Hindi makabuo ng key para sa wireless debugging.\nIto ay
        maaaring dahil ang mekanismo ng KeyStore ng device na ito ay sira.</string>
    <string name="adb_error_stop_tcp">Nabigo na pigilan ang ADB sa TCP</string>
    <string name="adb_pair_required">Sundin muna ang mga hakbang sa pagpapares.</string>
    <string name="enable">Paganahin</string>
    <string name="auto_pair_instructions">Magpares nang Hindi nagta-type ng code:\n\n1. I-tap ang \'Mga opsyo ng developer\" sa ibaba\n\nAwtomatikong bubukasn ng Shizuku ang \"Wireless na pag-debug\" at ang dialog ng pagpares, pagbasa ng code at port at simulan ito. Panatilihing bukas ang dialog hanggang matapos ang pagpares.</string>
    <string name="auto_pair_manual">Mano-mano</string>
    <string name="development_settings">Mga opsyon ng developer</string>
    <string name="notification_settings">Mga opsyon sa notipikasyon</string>
    <string name="adb_pairing_tutorial_content_notification">Tutulungan ka ng isang notipikasyon mula sa Shizuku na tapusin ang pagpapares.</string>
    <string name="adb_pairing_tutorial_content_steps">Magpunta sa \"Mga opsyon ng developer\", pagkatapos ay paganahin ang \"Pag-debug ng USB\" at \"Wireless na pag-debug\".</string>
    <string name="adb_pairing_tutorial_content_enter_pairing_code">I-tap ang kaliwang bahagi ng \"Wireless na pag-debug\", pagkatapos ay i-tap ang \"Ipares ang device sa pagpapares ng code\". Ilagay ang code sa notification para makumpleto ang pagpapares.</string>
    <string name="adb_pairing_tutorial_content_notification_blocked">Kailangan mong mag-interact sa notification mula sa Shizuku para makumpleto ang proseso sa pagpapares. Mangyaring payagan ang Shizuku na magpadala ng mga notipikasyon.</string>
    <string name="adb_pairing_tutorial_content_miui">Maaaring kailangan ng mga gumagamit ng MIUI na gawing \"Android\" ang notification style sa \"Notification\" - \"Notification shade\" sa system settings.</string>
    <string name="adb_pairing_tutorial_content_miui_2">Kung hindi, maaaring hindi mo mailalagay ang code ng pagpapares mula sa notification.</string>
    <string name="adb_pairing_tutorial_content_finish">Bumalik sa Shizuku at simulan ang Shizuku.</string>
    <string name="adb_pairing_tutorial_content_network">Kailangang ma-access ng Shizuku ang lokal na network. Ito ay kinokontrol ng pahintulot ng network.</string>
    <string name="adb_pairing_tutorial_content_network_limation_not_foreground">Hindi pinapayagan ng ilang system (gaya ng MIUI) ang mga app na i-access ang network kapag hindi nakikita ang mga ito, kahit na gumagamit ang app ng foreground services. Mangyaring i-turn off ang \"Battery optimization\" para sa Shizuku sa mga naturang system.</string>
